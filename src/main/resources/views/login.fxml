<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="auctionsystemclient.controller.LoginController"
           stylesheets="@../styles/global.css"
           style="-fx-background-color: #0a0a0f;">

    <StackPane style="-fx-background-color: linear-gradient(to bottom right, rgba(139, 92, 246, 0.1), rgba(236, 72, 153, 0.05));">
        <StackPane style="-fx-background-color: transparent;" fx:id="gridBackground"/>
    </StackPane>

    <HBox alignment="CENTER" spacing="0">

        <VBox fx:id="leftPanel" HBox.hgrow="ALWAYS" minWidth="400" maxWidth="Infinity" style="-fx-background-color: linear-gradient(to bottom right, rgba(139, 92, 246, 0.2), rgba(236, 72, 153, 0.1)); -fx-padding: 60;" alignment="CENTER_LEFT" spacing="30">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <StackPane style="-fx-background-color: linear-gradient(to bottom right, #8b5cf6, #ec4899); -fx-background-radius: 12;" prefWidth="50" prefHeight="50">
                    <Label text="⚡" style="-fx-font-size: 24;"/>
                </StackPane>
                <Label text="AuctionSpace" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </HBox>

            <VBox spacing="10">
                <Label text="Chào mừng" style="-fx-font-size: 48; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="trở lại" style="-fx-font-size: 48; -fx-font-weight: bold; -fx-text-fill: linear-gradient(to right, #a78bfa, #f9a8d4);"/>
            </VBox>

            <Label text="Đăng nhập để tiếp tục đấu giá và khám phá những sản phẩm độc đáo." style="-fx-font-size: 16; -fx-text-fill: #9ca3af; -fx-wrap-text: true;" maxWidth="400"/>

            <HBox spacing="30" alignment="CENTER_LEFT" style="-fx-padding: 40 0 0 0;">
                <VBox spacing="5">
                    <Label text="50K+" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Người dùng" style="-fx-font-size: 14; -fx-text-fill: #6b7280;"/>
                </VBox>
                <Separator orientation="VERTICAL" style="-fx-background-color: #374151;" prefHeight="60"/>
                <VBox spacing="5">
                    <Label text="10K+" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Sản phẩm" style="-fx-font-size: 14; -fx-text-fill: #6b7280;"/>
                </VBox>
                <Separator orientation="VERTICAL" style="-fx-background-color: #374151;" prefHeight="60"/>
                <VBox spacing="5">
                    <Label text="99%" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Uy tín" style="-fx-font-size: 14; -fx-text-fill: #6b7280;"/>
                </VBox>
            </HBox>
        </VBox>

        <ScrollPane fitToWidth="true" fitToHeight="true" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background: #0a0a0f; -fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox fx:id="rightPanel" alignment="CENTER" spacing="25" style="-fx-background-color: #0a0a0f; -fx-padding: 60;">

                <HBox spacing="5" alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 12; -fx-padding: 5;" maxWidth="350">
                    <Button fx:id="loginTab" text="Đăng nhập" style="-fx-background-color: linear-gradient(to right, #8b5cf6, #ec4899); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 30;" onAction="#handleLoginTab"/>
                    <Button fx:id="registerTab" text="Đăng ký" style="-fx-background-color: transparent; -fx-text-fill: #9ca3af; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 30;" onAction="#handleRegisterTab"/>
                </HBox>

                <VBox fx:id="loginForm" spacing="20" visible="true" managed="true" maxWidth="350">
                    <VBox spacing="8">
                        <Label text="Tên đăng nhập" style="-fx-font-size: 14; -fx-text-fill: #9ca3af;"/>
                        <TextField fx:id="usernameField" promptText="Nhập tên đăng nhập" style="-fx-background-color: rgba(255,255,255,0.05); -fx-border-color: #374151; -fx-border-radius: 12; -fx-background-radius: 12; -fx-text-fill: white; -fx-padding: 15; -fx-prompt-text-fill: #6b7280;"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Mật khẩu" style="-fx-font-size: 14; -fx-text-fill: #9ca3af;"/>
                        <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu" style="-fx-background-color: rgba(255,255,255,0.05); -fx-border-color: #374151; -fx-border-radius: 12; -fx-background-radius: 12; -fx-text-fill: white; -fx-padding: 15; -fx-prompt-text-fill: #6b7280;"/>
                    </VBox>
                    <Label fx:id="errorLabel" text="" style="-fx-text-fill: #ef4444; -fx-font-size: 14;" visible="false"/>
                    <Button text="Đăng nhập" onAction="#handleLogin" style="-fx-background-color: linear-gradient(to right, #8b5cf6, #ec4899); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-padding: 15; -fx-cursor: hand;" maxWidth="Infinity">
                        <effect><DropShadow color="#8b5cf6" radius="10" spread="0.2"/></effect>
                    </Button>
                </VBox>

                <VBox fx:id="registerForm" spacing="20" visible="false" managed="false" maxWidth="350">
                    <VBox spacing="8">
                        <Label text="Bạn muốn tham gia với tư cách" style="-fx-font-size: 14; -fx-text-fill: #9ca3af;"/>
                        <HBox spacing="10">
                            <ToggleButton fx:id="bidderRole" text="Người mua" style="-fx-background-color: rgba(139, 92, 246, 0.2); -fx-border-color: #8b5cf6; -fx-border-radius: 10; -fx-background-radius: 10; -fx-text-fill: white; -fx-padding: 15; -fx-cursor: hand;" selected="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <ToggleButton fx:id="sellerRole" text="Người bán" style="-fx-background-color: transparent; -fx-border-color: #374151; -fx-border-radius: 10; -fx-background-radius: 10; -fx-text-fill: #9ca3af; -fx-padding: 15; -fx-cursor: hand;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Tên đăng nhập" style="-fx-font-size: 14; -fx-text-fill: #9ca3af;"/>
                        <TextField fx:id="regUsernameField" promptText="Nhập tên đăng nhập" style="-fx-background-color: rgba(255,255,255,0.05); -fx-border-color: #374151; -fx-border-radius: 12; -fx-background-radius: 12; -fx-text-fill: white; -fx-padding: 15; -fx-prompt-text-fill: #6b7280;"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Email" style="-fx-font-size: 14; -fx-text-fill: #9ca3af;"/>
                        <TextField fx:id="emailField" promptText="Nhập email của bạn" style="-fx-background-color: rgba(255,255,255,0.05); -fx-border-color: #374151; -fx-border-radius: 12; -fx-background-radius: 12; -fx-text-fill: white; -fx-padding: 15; -fx-prompt-text-fill: #6b7280;"/>
                    </VBox>
                    <VBox fx:id="storeNameContainer" spacing="8" visible="false" managed="false">
                        <Label text="Tên cửa hàng" style="-fx-font-size: 14; -fx-text-fill: #9ca3af;"/>
                        <TextField fx:id="storeNameField" promptText="Nhập tên cửa hàng" style="-fx-background-color: rgba(255,255,255,0.05); -fx-border-color: #374151; -fx-border-radius: 12; -fx-background-radius: 12; -fx-text-fill: white; -fx-padding: 15; -fx-prompt-text-fill: #6b7280;"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Mật khẩu" style="-fx-font-size: 14; -fx-text-fill: #9ca3af;"/>
                        <PasswordField fx:id="regPasswordField" promptText="Nhập mật khẩu" style="-fx-background-color: rgba(255,255,255,0.05); -fx-border-color: #374151; -fx-border-radius: 12; -fx-background-radius: 12; -fx-text-fill: white; -fx-padding: 15; -fx-prompt-text-fill: #6b7280;"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Xác nhận mật khẩu" style="-fx-font-size: 14; -fx-text-fill: #9ca3af;"/>
                        <PasswordField fx:id="confirmPasswordField" promptText="Nhập lại mật khẩu" style="-fx-background-color: rgba(255,255,255,0.05); -fx-border-color: #374151; -fx-border-radius: 12; -fx-background-radius: 12; -fx-text-fill: white; -fx-padding: 15; -fx-prompt-text-fill: #6b7280;"/>
                    </VBox>
                    <Button text="Tạo tài khoản" onAction="#handleRegister" style="-fx-background-color: linear-gradient(to right, #8b5cf6, #ec4899); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-padding: 15; -fx-cursor: hand;" maxWidth="Infinity">
                        <effect><DropShadow color="#8b5cf6" radius="10" spread="0.2"/></effect>
                    </Button>
                    <Label text="Bằng cách đăng ký, bạn đồng ý với Điều khoản và Chính sách bảo mật" style="-fx-font-size: 12; -fx-text-fill: #6b7280; -fx-wrap-text: true;" textAlignment="CENTER"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </HBox>
</StackPane>