<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.team4.controller.ProfileController"
      spacing="24"
      style="-fx-background-color: transparent;"
      prefWidth="800" maxWidth="900" alignment="TOP_CENTER">

    <padding>
        <Insets top="20" right="40" bottom="40" left="40"/>
    </padding>

    <VBox styleClass="profile-card" spacing="32">

        <HBox spacing="24" alignment="CENTER_LEFT">
            <StackPane style="-fx-background-color: linear-gradient(to bottom right, #8b5cf6, #ec4899); -fx-background-radius: 50%;"
                       prefWidth="88" prefHeight="88">
                <Label fx:id="avatarText" text="U" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </StackPane>
            <VBox spacing="6" alignment="CENTER_LEFT">
                <Label fx:id="displayName" text="User Name" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="roleBadge" text="BIDDER"
                           style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #8b5cf6; -fx-padding: 4 12; -fx-background-color: rgba(139,92,246,0.15); -fx-background-radius: 20;"/>
                    <Label fx:id="statusBadge" text="● Active"
                           style="-fx-font-size: 12; -fx-text-fill: #22c55e;"/>
                </HBox>
                <Label fx:id="emailDisplay" text="user@email.com" style="-fx-font-size: 14; -fx-text-fill: #6b7280;"/>
            </VBox>
        </HBox>

        <Separator styleClass="profile-sep"/>

        <VBox spacing="20">
            <Label text="Update profile" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Username" styleClass="form-label"/>
                    <TextField fx:id="editName" styleClass="input-field"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Email" styleClass="form-label"/>
                    <TextField fx:id="editEmail" styleClass="input-field"/>
                </VBox>
            </HBox>

            <VBox spacing="6">
                <Label text="Phone number" styleClass="form-label"/>
                <TextField fx:id="editPhone" styleClass="input-field"/>
            </VBox>
        </VBox>

        <Separator styleClass="profile-sep"/>

        <VBox spacing="20">
            <Label text="Change password" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <VBox spacing="6">
                <Label text="Current password" styleClass="form-label"/>
                <PasswordField fx:id="currentPassword" promptText="Enter current password" styleClass="input-field"/>
            </VBox>

            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="New password" styleClass="form-label"/>
                    <PasswordField fx:id="newPassword" promptText="Enter new password" styleClass="input-field"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Confirm new password" styleClass="form-label"/>
                    <PasswordField fx:id="confirmPassword" promptText="Confirm new password" styleClass="input-field"/>
                </VBox>
            </HBox>
        </VBox>

        <HBox spacing="12" alignment="CENTER_RIGHT">
            <Button fx:id="saveBtn" text="💾 Save change" onAction="#onSaveProfile" styleClass="btn-primary"/>
            <Button fx:id="cancelBtn" text="Cancel" onAction="#onCancel" styleClass="btn-secondary"/>
        </HBox>
    </VBox>
</VBox>