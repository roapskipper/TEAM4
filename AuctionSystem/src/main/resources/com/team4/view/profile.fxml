<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.team4.controller.ProfileController"
      spacing="24"
      style="-fx-background-color: transparent;"
      prefWidth="820" maxWidth="900" alignment="TOP_CENTER">

    <padding>
        <Insets top="20" right="40" bottom="40" left="40"/>
    </padding>

    <VBox styleClass="profile-card" spacing="32" maxWidth="820">

        <HBox spacing="24" alignment="CENTER_LEFT" styleClass="profile-identity-band">
            <HBox spacing="24" alignment="CENTER_LEFT" minWidth="0" HBox.hgrow="ALWAYS">
                <StackPane styleClass="profile-identity-tile"
                           minWidth="104" prefWidth="104" maxWidth="104"
                           minHeight="104" prefHeight="104" maxHeight="104">
                    <VBox alignment="CENTER" spacing="3">
                        <Label fx:id="avatarText" text="USR" styleClass="profile-identity-initials"/>
                        <Label fx:id="avatarRoleText" text="USER" styleClass="profile-identity-role"/>
                    </VBox>
                </StackPane>
                <VBox spacing="6" alignment="CENTER_LEFT" minWidth="0" HBox.hgrow="ALWAYS">
                    <Label fx:id="displayName" text="User Name"
                           maxWidth="Infinity"
                           styleClass="section-title-large"
                           style="-fx-font-size: 28;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label fx:id="roleBadge" text="BIDDER" styleClass="role-badge"/>
                        <Label fx:id="statusBadge" text="Active" styleClass="status-active"/>
                    </HBox>
                    <Label fx:id="emailDisplay" text="user@email.com"
                           maxWidth="Infinity"
                           styleClass="muted-text"
                           style="-fx-font-size: 14;"/>
                </VBox>
            </HBox>

            <VBox spacing="10"
                  minWidth="240" prefWidth="260" maxWidth="280"
                  styleClass="profile-snapshot-panel">
                <Label fx:id="snapshotTitle" text="Account Snapshot" styleClass="profile-snapshot-title"/>
                <GridPane hgap="12" vgap="7">
                    <columnConstraints>
                        <ColumnConstraints minWidth="64"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label fx:id="snapshotPrimaryLabel" text="Access"
                           styleClass="profile-snapshot-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label fx:id="snapshotPrimaryValue" text="Standard"
                           maxWidth="Infinity"
                           styleClass="profile-snapshot-value"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label fx:id="snapshotJoinedLabel" text="Joined"
                           styleClass="profile-snapshot-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Label fx:id="snapshotJoinedValue" text="Not available"
                           maxWidth="Infinity"
                           styleClass="profile-snapshot-value"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label fx:id="snapshotStatusLabel" text="Status"
                           styleClass="profile-snapshot-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <Label fx:id="snapshotStatusValue" text="Active"
                           maxWidth="Infinity"
                           styleClass="profile-snapshot-status-value"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                </GridPane>
            </VBox>
        </HBox>

        <Separator styleClass="profile-sep"/>

        <VBox spacing="20">
            <Label text="Update Profile" styleClass="section-title" style="-fx-font-size: 18;"/>

            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Full Name" styleClass="form-label"/>
                    <TextField fx:id="editName" styleClass="input-field"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Email" styleClass="form-label"/>
                    <TextField fx:id="editEmail" styleClass="input-field"/>
                </VBox>
            </HBox>

            <VBox spacing="6">
                <Label text="Phone Number" styleClass="form-label"/>
                <TextField fx:id="editPhone" styleClass="input-field"/>
            </VBox>
        </VBox>

        <Separator styleClass="profile-sep"/>

        <VBox spacing="20">
            <Label text="Change Password" styleClass="section-title" style="-fx-font-size: 18;"/>

            <VBox spacing="6">
                <Label text="Current Password" styleClass="form-label"/>
                <PasswordField fx:id="currentPassword" promptText="Enter current password" styleClass="input-field"/>
            </VBox>

            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="New Password" styleClass="form-label"/>
                    <PasswordField fx:id="newPassword" promptText="Enter new password" styleClass="input-field"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Confirm New Password" styleClass="form-label"/>
                    <PasswordField fx:id="confirmPassword" promptText="Confirm new password" styleClass="input-field"/>
                </VBox>
            </HBox>
        </VBox>

        <HBox spacing="12" alignment="CENTER_RIGHT">
            <Button fx:id="saveBtn" text="Save Changes" onAction="#onSaveProfile" styleClass="btn-primary"/>
            <Button fx:id="cancelBtn" text="Cancel" onAction="#onCancel" styleClass="btn-secondary"/>
        </HBox>
    </VBox>
</VBox>
