<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.team4.controller.ProfileController"
      spacing="24"
      style="-fx-background-color: transparent;"
      prefWidth="800" maxWidth="900" alignment="TOP_CENTER">

    <padding>
        <Insets top="20" right="40" bottom="40" left="40"/>
    </padding>

    <VBox styleClass="profile-card" spacing="32">

        <HBox spacing="24" alignment="CENTER_LEFT">
            <StackPane styleClass="brand-icon-bg-circle"
                       prefWidth="88" prefHeight="88">
                <Label fx:id="avatarText" text="U"
                       styleClass="brand-icon-text"
                       style="-fx-font-size: 36;"/>
            </StackPane>
            <VBox spacing="6" alignment="CENTER_LEFT">
                <Label fx:id="displayName" text="User Name"
                       styleClass="section-title-large"
                       style="-fx-font-size: 28;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="roleBadge" text="BIDDER" styleClass="role-badge"/>
                    <Label fx:id="statusBadge" text="Active" styleClass="status-active"/>
                </HBox>
                <Label fx:id="emailDisplay" text="user@email.com"
                       styleClass="muted-text"
                       style="-fx-font-size: 14;"/>
            </VBox>
        </HBox>

        <GridPane hgap="12" vgap="12" styleClass="account-summary-grid">
            <columnConstraints>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
            </columnConstraints>

            <VBox spacing="4" styleClass="account-summary-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="Role" styleClass="account-summary-label"/>
                <Label fx:id="summaryRole" maxWidth="Infinity" text="Bidder" styleClass="account-summary-value" wrapText="true"/>
            </VBox>
            <VBox spacing="4" styleClass="account-summary-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="Balance" styleClass="account-summary-label"/>
                <Label fx:id="summaryBalance" maxWidth="Infinity" text="0 VND" styleClass="account-summary-money" style="-fx-text-fill: #722F37;" wrapText="true"/>
            </VBox>
            <VBox spacing="4" styleClass="account-summary-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <Label text="Member Since" styleClass="account-summary-label"/>
                <Label fx:id="summaryJoined" maxWidth="Infinity" text="Not available" styleClass="account-summary-value" wrapText="true"/>
            </VBox>
            <VBox spacing="4" styleClass="account-summary-card" GridPane.columnIndex="3" GridPane.rowIndex="0">
                <Label text="Contact" styleClass="account-summary-label"/>
                <Label fx:id="summaryContact" maxWidth="Infinity" text="Not provided" styleClass="account-summary-value" wrapText="true"/>
            </VBox>

            <VBox spacing="4" styleClass="account-summary-note" GridPane.columnIndex="0" GridPane.columnSpan="4" GridPane.rowIndex="1">
                <Label text="Account Detail" styleClass="account-summary-label"/>
                <Label fx:id="summaryRoleDetail" maxWidth="Infinity" text="Account details" styleClass="account-summary-detail" wrapText="true"/>
            </VBox>
        </GridPane>

        <Separator styleClass="profile-sep"/>

        <VBox spacing="20">
            <Label text="Update Profile" styleClass="section-title" style="-fx-font-size: 18;"/>

            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Username" styleClass="form-label"/>
                    <TextField fx:id="editName" styleClass="input-field"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Email" styleClass="form-label"/>
                    <TextField fx:id="editEmail" styleClass="input-field"/>
                </VBox>
            </HBox>

            <VBox spacing="6">
                <Label text="Phone Number" styleClass="form-label"/>
                <TextField fx:id="editPhone" styleClass="input-field"/>
            </VBox>
        </VBox>

        <Separator styleClass="profile-sep"/>

        <VBox spacing="20">
            <Label text="Change Password" styleClass="section-title" style="-fx-font-size: 18;"/>

            <VBox spacing="6">
                <Label text="Current Password" styleClass="form-label"/>
                <PasswordField fx:id="currentPassword" promptText="Enter current password" styleClass="input-field"/>
            </VBox>

            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="New Password" styleClass="form-label"/>
                    <PasswordField fx:id="newPassword" promptText="Enter new password" styleClass="input-field"/>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Confirm New Password" styleClass="form-label"/>
                    <PasswordField fx:id="confirmPassword" promptText="Confirm new password" styleClass="input-field"/>
                </VBox>
            </HBox>
        </VBox>

        <HBox spacing="12" alignment="CENTER_RIGHT">
            <Button fx:id="saveBtn" text="Save Changes" onAction="#onSaveProfile" styleClass="btn-primary"/>
            <Button fx:id="cancelBtn" text="Cancel" onAction="#onCancel" styleClass="btn-secondary"/>
        </HBox>
    </VBox>
</VBox>
