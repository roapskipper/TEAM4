<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.team4.controller.BiddingRoomController"
      spacing="20"
      style="-fx-background-color: transparent;"
      prefWidth="1200">

    <HBox spacing="20" alignment="CENTER_LEFT">
        <VBox styleClass="bidding-card" HBox.hgrow="ALWAYS">
            <HBox spacing="16" alignment="CENTER_LEFT">
                <StackPane styleClass="brand-icon-bg"
                           prefWidth="80" prefHeight="80">
                    <Label text="ITEM" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </StackPane>
                <VBox spacing="4">
                    <Label fx:id="itemName" text="Loading auction..."
                           styleClass="section-title-large"
                           style="-fx-font-size: 20;"/>
                    <HBox spacing="8">
                        <Label fx:id="itemCategory" text="..." styleClass="badge badge-blue"/>
                        <Label fx:id="itemCondition" text="..." styleClass="badge badge-green"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 4 0 0 0;">
                        <Label fx:id="sellerName" text=""
                               styleClass="muted-text"
                               style="-fx-font-size: 13;"/>
                        <Label fx:id="sellerRating" text="" styleClass="rating-star"/>
                        <Label text="Verified" styleClass="verified-mark"/>
                    </HBox>
                    <Label fx:id="itemDescription"
                           text=""
                           styleClass="muted-text"
                           wrapText="true"
                           maxWidth="520"/>
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="bidding-price-card" alignment="CENTER" spacing="8">
            <Label text="Current Price" styleClass="muted-text"/>
            <Label fx:id="currentPrice" text="..." styleClass="price-display"/>
            <VBox spacing="6" alignment="CENTER">
                <HBox spacing="12" alignment="CENTER">
                    <HBox spacing="4" alignment="CENTER_LEFT">
                        <Label text="Start" styleClass="muted-text"/>
                        <Label fx:id="startingPriceLabel" text="..."
                               styleClass="price-mini-value"
                               style="-fx-font-size: 12;"/>
                    </HBox>
                    <Label text="-" styleClass="dot-separator"/>
                    <HBox spacing="4" alignment="CENTER_LEFT">
                        <Label text="Bids" styleClass="muted-text"/>
                        <Label fx:id="bidCount" text="0 bids"
                               styleClass="muted-text"
                               style="-fx-font-size: 13;"/>
                    </HBox>
                </HBox>
                <HBox spacing="12" alignment="CENTER">
                    <HBox spacing="4" alignment="CENTER_LEFT">
                        <Label text="Time" styleClass="muted-text"/>
                        <Label fx:id="timeLeft" text="--:--:--" styleClass="timer-urgent"/>
                    </HBox>
                    <Label text="-" styleClass="dot-separator"/>
                    <HBox spacing="4" alignment="CENTER_LEFT">
                        <Label text="Step" styleClass="muted-text"/>
                        <Label fx:id="bidIncrementLabel" text="..." styleClass="price-mini-value" style="-fx-font-size: 12;"/>
                    </HBox>
                </HBox>
            </VBox>
        </VBox>
    </HBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <VBox spacing="16" HBox.hgrow="ALWAYS" prefWidth="700">
            <VBox styleClass="bidding-card" prefHeight="320">
                <Label text="Price Chart" styleClass="section-title"/>
                <AreaChart fx:id="priceChart" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                    <xAxis><NumberAxis label="Time" style="-fx-tick-label-fill: #555555;"/></xAxis>
                    <yAxis><NumberAxis label="Price (VND)" style="-fx-tick-label-fill: #555555;"/></yAxis>
                </AreaChart>
            </VBox>

            <VBox styleClass="bidding-card" prefHeight="220">
                <Label text="Bid History" styleClass="section-title"/>
                <ListView fx:id="bidHistoryList" VBox.vgrow="ALWAYS" styleClass="bid-list"/>
            </VBox>
        </VBox>

        <VBox spacing="16" prefWidth="380">

            <VBox styleClass="bidding-card" spacing="14">
                <Label text="Place Bid" styleClass="section-title"/>

                <HBox spacing="8">
                    <Button fx:id="quick100k" text="+Step" onAction="#onQuickBid" styleClass="quick-bid-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="quick200k" text="+2x" onAction="#onQuickBid" styleClass="quick-bid-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="quick500k" text="+5x" onAction="#onQuickBid" styleClass="quick-bid-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="quick1m" text="+10x" onAction="#onQuickBid" styleClass="quick-bid-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>

                <VBox spacing="6">
                    <Label text="Or enter amount" styleClass="muted-text"/>
                    <TextField fx:id="bidAmountField" promptText="Enter amount" styleClass="input-field"/>
                    <HBox>
                        <Label text="Min: " styleClass="price-mini-label"/>
                        <Label fx:id="minBidLabel" text="..." styleClass="price-mini-value"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Step: " styleClass="price-mini-label"/>
                        <Label fx:id="bidStepLabel" text="..." styleClass="price-mini-value"/>
                    </HBox>
                </VBox>

                <Label fx:id="bidError" text="" managed="false" visible="false" styleClass="error-message"/>

                <Button fx:id="placeBidBtn" text="Place Bid Now" onAction="#onPlaceBid" styleClass="btn-primary"/>

                <VBox spacing="8" style="-fx-padding: 8 0 0 0;">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ToggleButton fx:id="autoBidToggle" text="Auto Bid" onAction="#onAutoBidToggle" styleClass="auto-bid-toggle"/>
                    </HBox>
                    <VBox fx:id="autoBidPanel" spacing="6" managed="false" visible="false">
                        <TextField fx:id="autoBidMax" promptText="Max price (VND)" styleClass="input-field"/>
                        <TextField fx:id="autoBidIncrement" promptText="Increment (VND)" styleClass="input-field"/>
                        <Label text="System will automatically bid on your behalf" styleClass="muted-text-sm" wrapText="true"/>
                    </VBox>
                </VBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>
