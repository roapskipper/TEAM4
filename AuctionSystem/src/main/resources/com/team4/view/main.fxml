<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.Group?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.team4.controller.MainController"
            fx:id="mainRoot"
            stylesheets="@style.css"
            prefWidth="1400" prefHeight="900"
            styleClass="app-bg">

    <left>
        <VBox fx:id="sidebar"
              styleClass="surface-sidebar"
              prefWidth="220" minWidth="180" maxWidth="260"
              spacing="0">

            <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 24 20 16 20;">
                <StackPane styleClass="brand-logo-mark"
                           prefWidth="40" prefHeight="40">
                    <Group>
                        <Rectangle x="10" y="14" width="21" height="7" arcWidth="2" arcHeight="2" rotate="-25" styleClass="brand-logo-gavel"/>
                        <Rectangle x="18" y="11" width="5" height="12" arcWidth="1" arcHeight="1" rotate="-25" styleClass="brand-logo-gavel-cap"/>
                        <Rectangle x="25" y="19" width="5" height="20" arcWidth="2" arcHeight="2" rotate="-25" styleClass="brand-logo-gavel"/>
                        <Line startX="9" startY="36" endX="34" endY="36" styleClass="brand-logo-base"/>
                        <Circle centerX="12" centerY="30" radius="3" styleClass="brand-logo-coin"/>
                    </Group>
                </StackPane>
                <VBox spacing="2">
                    <Label text="AuctionSpace" styleClass="brand-name"/>
                    <Label text="Auction System" styleClass="brand-tagline"/>
                </VBox>
            </HBox>

            <Separator styleClass="sidebar-sep"/>

            <VBox fx:id="navContainer" spacing="4" style="-fx-padding: 12 14;">
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <VBox styleClass="user-footer" spacing="12">
                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="user-summary">
                    <StackPane fx:id="userAvatarBg"
                               styleClass="brand-icon-bg-circle"
                               minWidth="38" prefWidth="38" maxWidth="38"
                               minHeight="38" prefHeight="38" maxHeight="38">
                        <Label fx:id="userAvatarText" text="U"
                               styleClass="brand-icon-text"
                               style="-fx-font-size: 14;"/>
                    </StackPane>

                    <VBox spacing="4" HBox.hgrow="ALWAYS" minWidth="0">
                        <Label fx:id="userNameLabel" text="User"
                               styleClass="user-name"
                               maxWidth="Infinity"
                               textOverrun="ELLIPSIS"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label fx:id="userRoleBadge" text="BIDDER"
                                   styleClass="role-badge"/>
                            <Label fx:id="userStatusDot" text="Active"
                                   styleClass="status-active"/>
                        </HBox>
                    </VBox>
                </HBox>

                <Label fx:id="balanceValueLabel"
                       text="Balance: --"
                       maxWidth="Infinity"
                       styleClass="balance-pill"/>

                <Button fx:id="logoutBtn"
                        text="Logout"
                        maxWidth="Infinity"
                        onAction="#onLogout"
                        styleClass="logout-btn">
                    <tooltip>
                        <Tooltip text="Logout"/>
                    </tooltip>
                </Button>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="0">
            <HBox fx:id="headerBar"
                  alignment="CENTER_LEFT"
                  spacing="16"
                  styleClass="surface-header"
                  style="-fx-padding: 16 28;">

                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label fx:id="pageTitle"
                           text="Dashboard"
                           styleClass="section-title-large"/>
                    <Label fx:id="pageSubtitle" text="Overview"
                           styleClass="brand-tagline"/>
                </VBox>

                <StackPane>
                    <Button fx:id="notiBtn"
                            text="Alerts"
                            onAction="#onNotificationClick"
                            styleClass="icon-btn"/>
                    <Label fx:id="notiBadge" text="3"
                           styleClass="noti-badge"
                           translateX="12" translateY="-12"
                           visible="false"/>
                </StackPane>
            </HBox>

            <ScrollPane fx:id="contentScroll"
                        VBox.vgrow="ALWAYS"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="content-scroll-pane">
                <content>
                    <StackPane fx:id="contentArea" styleClass="app-bg">
                        <padding>
                            <Insets top="20" right="28" bottom="20" left="28"/>
                        </padding>
                    </StackPane>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
