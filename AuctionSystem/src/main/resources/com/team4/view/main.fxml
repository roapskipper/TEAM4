<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.team4.controller.MainController"
            fx:id="mainRoot"
            stylesheets="@style.css"
            prefWidth="1400" prefHeight="900"
            style="-fx-background-color: #0a0a0f;">

    <left>
        <VBox fx:id="sidebar"
              style="-fx-background-color: #111118;"
              prefWidth="270" minWidth="220" maxWidth="320"
              spacing="0">
            <VBox.styleString>-fx-border-color: transparent rgba(255,255,255,0.04) transparent transparent;</VBox.styleString>

            <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 24 20 16 20;">
                <StackPane style="-fx-background-color: linear-gradient(to bottom right, #8b5cf6, #ec4899); -fx-background-radius: 12;"
                           prefWidth="40" prefHeight="40">
                    <Label text="⚡" style="-fx-font-size: 20; -fx-text-fill: white;"/>
                </StackPane>
                <VBox spacing="2">
                    <Label text="AuctionSpace" style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="He thong dau gia" style="-fx-font-size: 11; -fx-text-fill: #4b5563;"/>
                </VBox>
            </HBox>

            <Separator styleClass="sidebar-sep"/>

            <VBox fx:id="navContainer" spacing="4" style="-fx-padding: 12 14;">
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <VBox style="-fx-padding: 16;"
                  styleString="-fx-border-color: rgba(255,255,255,0.04) transparent transparent transparent;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <StackPane fx:id="userAvatarBg"
                               style="-fx-background-color: linear-gradient(to bottom right, #8b5cf6, #ec4899); -fx-background-radius: 50%;"
                               prefWidth="38" prefHeight="38">
                        <Label fx:id="userAvatarText" text="U"
                               style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    </StackPane>

                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="userNameLabel" text="User"
                               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label fx:id="userRoleBadge" text="BIDDER"
                                   style="-fx-font-size: 10; -fx-text-fill: #8b5cf6; -fx-padding: 2 8; -fx-background-color: rgba(139,92,246,0.15); -fx-background-radius: 20;"/>
                            <Label fx:id="userStatusDot" text="●"
                                   style="-fx-font-size: 8; -fx-text-fill: #22c55e;"/>
                        </HBox>
                    </VBox>

                    <Button fx:id="logoutBtn"
                            text="↩"
                            onAction="#onLogout"
                            style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-font-size: 18; -fx-padding: 4 8; -fx-cursor: hand;"
                            tooltip="Dang xuat">
                    </Button>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="0">
            <HBox fx:id="headerBar"
                  alignment="CENTER_LEFT"
                  spacing="16"
                  style="-fx-background-color: rgba(10,10,15,0.85); -fx-padding: 16 28;">
                <HBox.styleString>-fx-border-color: transparent transparent rgba(255,255,255,0.04) transparent;</HBox.styleString>

                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label fx:id="pageTitle"
                           text="Dashboard"
                           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label fx:id="pageSubtitle" text="Thong tin tong quan"
                           style="-fx-font-size: 12; -fx-text-fill: #4b5563;"/>
                </VBox>

                <StackPane>
                    <Button fx:id="notiBtn"
                            text="🔔"
                            onAction="#onNotificationClick"
                            style="-fx-background-color: rgba(255,255,255,0.04); -fx-background-radius: 12; -fx-padding: 10 12; -fx-font-size: 16; -fx-cursor: hand;"/>
                    <Label fx:id="notiBadge" text="3"
                           style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 2 6; -fx-background-color: #ef4444; -fx-background-radius: 10;"
                           translateX="12" translateY="-12"
                           visible="false"/>
                </StackPane>
            </HBox>

            <StackPane fx:id="contentArea"
                       VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #0a0a0f;">
                <padding>
                    <Insets top="20" right="28" bottom="20" left="28"/>
                </padding>
            </StackPane>
        </VBox>
    </center>
</BorderPane>