<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.team4.controller.BidderOwnedItemsController"
      spacing="20"
      style="-fx-background-color: transparent;"
      prefWidth="1200">

    <HBox spacing="16">
        <VBox alignment="CENTER_LEFT" spacing="8" styleClass="owned-stat-card" HBox.hgrow="ALWAYS">
            <Label text="Owned Items" styleClass="owned-stat-label"/>
            <Label fx:id="ownedCount" text="0" styleClass="owned-stat-value-accent"/>
        </VBox>
        <VBox alignment="CENTER_LEFT" spacing="8" styleClass="owned-stat-card" HBox.hgrow="ALWAYS">
            <Label text="Total Winning Value" styleClass="owned-stat-label"/>
            <Label fx:id="totalValue" text="0 VND" styleClass="owned-stat-value"/>
        </VBox>
        <VBox alignment="CENTER_LEFT" spacing="8" styleClass="owned-stat-card" HBox.hgrow="ALWAYS">
            <Label text="Latest Win" styleClass="owned-stat-label"/>
            <Label fx:id="latestItem" maxWidth="Infinity" text="--" styleClass="owned-stat-value-muted" wrapText="true"/>
        </VBox>
    </HBox>

    <VBox styleClass="filter-panel owned-collection-panel" spacing="14">
        <HBox alignment="CENTER_LEFT">
            <Label text="Collection" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
        <FlowPane fx:id="ownedItemsGrid"
                  alignment="TOP_CENTER"
                  hgap="16"
                  vgap="16"
                  styleClass="owned-grid"
                  prefWrapLength="900"/>
    </VBox>
</VBox>
