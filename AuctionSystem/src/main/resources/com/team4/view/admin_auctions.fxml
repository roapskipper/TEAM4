<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.team4.controller.AdminAuctionsController"
      spacing="20"
      style="-fx-background-color: transparent;"
      prefWidth="1100">

    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="searchField"
                   promptText="Search auctions..."
                   styleClass="admin-input"
                   prefWidth="320"/>

        <HBox spacing="8">
            <Button fx:id="filterAll" text="All" onAction="#onFilterAll" styleClass="admin-filter-active"/>
            <Button fx:id="filterPending" text="Pending" onAction="#onFilterPending" styleClass="admin-filter"/>
            <Button fx:id="filterLive" text="Ongoing" onAction="#onFilterLive" styleClass="admin-filter"/>
            <Button fx:id="filterViolated" text="Violated" onAction="#onFilterViolated" styleClass="admin-filter"/>
        </HBox>

        <Region HBox.hgrow="ALWAYS" />

        <Label fx:id="resultCount" text="5 sessions" styleClass="muted-text"/>
    </HBox>

    <VBox styleClass="admin-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="auctionsTable" VBox.vgrow="ALWAYS" styleClass="admin-table">
            <columns>
                <TableColumn fx:id="colItem" text="Item" minWidth="260" prefWidth="300"/>
                <TableColumn fx:id="colSeller" text="Seller" minWidth="140" prefWidth="160"/>
                <TableColumn fx:id="colStartPrice" text="Start Price" minWidth="130" prefWidth="150"/>
                <TableColumn fx:id="colStatus" text="Status" minWidth="120" prefWidth="130"/>
                <TableColumn fx:id="colReports" text="Reports" minWidth="80" prefWidth="90"/>
                <TableColumn fx:id="colAction" text="Action" minWidth="150" prefWidth="170"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
