<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.team4.controller.AdminUsersController"
      spacing="20"
      style="-fx-background-color: transparent;"
      prefWidth="1100">

    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="searchField"
                   promptText="Search username or email..."
                   styleClass="admin-input"
                   prefWidth="320"/>

        <ComboBox fx:id="roleFilter" styleClass="admin-input" prefWidth="150" />

        <Region HBox.hgrow="ALWAYS" />

        <Label fx:id="resultCount" text="0 users" styleClass="muted-text"/>
    </HBox>

    <VBox styleClass="admin-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" styleClass="admin-table">
            <columns>
                <TableColumn fx:id="colUsername" text="Username" prefWidth="150"/>
                <TableColumn fx:id="colFullName" text="Full Name" prefWidth="200"/>
                <TableColumn fx:id="colRole" text="Role" prefWidth="100"/>
                <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
                <TableColumn fx:id="colJoinDate" text="Join Date" prefWidth="150"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="250"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>
