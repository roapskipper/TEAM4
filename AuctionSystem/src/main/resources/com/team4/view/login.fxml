<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.animation.*?>


<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.team4.controller.LoginController"
           stylesheets="@style.css"
           id="loginRoot"
           prefWidth="1280" prefHeight="720"
           styleClass="login-bg">

    <!-- ═══════════ BACKGROUND LAYER ═══════════ -->
    <StackPane id="bgLayer">
        <!-- Gradient base -->
        <StackPane style="-fx-background-color: #0a0a0f;" />

        <!-- Animated orbs -->
        <StackPane id="orbPurple"
                   style="-fx-background-color: radial-gradient(center 30% 40%, radius 60%, #8b5cf633, transparent);"
                   prefWidth="600" prefHeight="600" />
        <StackPane id="orbPink"
                   style="-fx-background-color: radial-gradient(center 70% 60%, radius 50%, #ec489922, transparent);"
                   prefWidth="500" prefHeight="500" />
        <StackPane id="orbBlue"
                   style="-fx-background-color: radial-gradient(center 50% 50%, radius 40%, #3b82f611, transparent);"
                   prefWidth="400" prefHeight="400" />

        <!-- Grid pattern -->
        <StackPane opacity="0.03"
                   style="-fx-background-color: repeating-linear-gradient(0deg, #ffffff08 0px, #ffffff08 1px, transparent 1px, transparent 60px), repeating-linear-gradient(90deg, #ffffff08 0px, #ffffff08 1px, transparent 1px, transparent 60px);" />
    </StackPane>

    <!-- ═══════════ MAIN CONTENT ═══════════ -->
    <HBox alignment="CENTER" spacing="0">

        <!-- ════ LEFT PANEL: BRANDING ════ -->
        <VBox id="leftPanel"
              style="-fx-background-color: linear-gradient(to bottom right, rgba(139,92,246,0.06), rgba(236,72,153,0.03));"
              prefWidth="580" minWidth="420" maxWidth="700"
              alignment="CENTER_LEFT"
              spacing="28">
            <padding>
                <Insets top="64" right="64" bottom="64" left="64"/>
            </padding>

            <!-- Brand Logo -->
            <HBox spacing="14" alignment="CENTER_LEFT">
                <StackPane style="-fx-background-color: linear-gradient(to bottom right, #8b5cf6, #ec4899); -fx-background-radius: 14;"
                           prefWidth="52" prefHeight="52">
                    <Label text="⚡" style="-fx-font-size: 26; -fx-text-fill: white;" />
                </StackPane>
                <VBox spacing="2">
                    <Label text="AuctionSpace" styleClass="brand-title"/>
                    <Label text="He thong dau gia truc tuyen" style="-fx-font-size: 13; -fx-text-fill: #6b7280;"/>
                </VBox>
            </HBox>

            <!-- Spacer -->
            <Region prefHeight="40" />

            <!-- Welcome Text -->
            <VBox spacing="8">
                <Label text="Chao mung" styleClass="hero-title"/>
                <Label text="tro lai" styleClass="hero-title-gradient"/>
                <Label text="Dang nhap de tiep tuc dau gia va kham pha nhung san pham doc dao tu khap noi."
                       wrapText="true" maxWidth="420" style="-fx-font-size: 16; -fx-text-fill: #9ca3af; -fx-line-spacing: 4;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Stats -->
            <HBox spacing="32" alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Label text="50K+" styleClass="stat-number"/>
                    <Label text="Nguoi dung" styleClass="stat-label"/>
                </VBox>
                <Separator orientation="VERTICAL" styleClass="stat-sep"/>
                <VBox spacing="4">
                    <Label text="10K+" styleClass="stat-number"/>
                    <Label text="San pham" styleClass="stat-label"/>
                </VBox>
                <Separator orientation="VERTICAL" styleClass="stat-sep"/>
                <VBox spacing="4">
                    <Label text="99%" styleClass="stat-number"/>
                    <Label text="Uy tin" styleClass="stat-label"/>
                </VBox>
            </HBox>

            <!-- Bottom badge -->
            <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 20 0 0 0;">
                <Label text="UET-VNU" style="-fx-text-fill: #4b5563; -fx-font-size: 12; -fx-font-weight: bold;"/>
                <Label text="•" style="-fx-text-fill: #374151;"/>
                <Label text="CN1 2024" style="-fx-text-fill: #4b5563; -fx-font-size: 12;"/>
                <Label text="•" style="-fx-text-fill: #374151;"/>
                <Label text="Nhom 4" style="-fx-text-fill: #4b5563; -fx-font-size: 12;"/>
            </HBox>
        </VBox>

        <!-- ════ RIGHT PANEL: FORM ════ -->
        <VBox id="rightPanel"
              prefWidth="480" minWidth="380" maxWidth="600"
              alignment="CENTER"
              spacing="24"
              style="-fx-background-color: #0a0a0f;">
            <padding>
                <Insets top="48" right="56" bottom="48" left="56"/>
            </padding>

            <!-- Mobile Logo (hidden on desktop) -->
            <HBox id="mobileLogo" spacing="10" alignment="CENTER" managed="false" visible="false">
                <StackPane style="-fx-background-color: linear-gradient(to bottom right, #8b5cf6, #ec4899); -fx-background-radius: 12;"
                           prefWidth="40" prefHeight="40">
                    <Label text="⚡" style="-fx-font-size: 20; -fx-text-fill: white;" />
                </StackPane>
                <Label text="AuctionSpace" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </HBox>

            <!-- ═══ TAB SWITCHER ═══ -->
            <HBox id="tabSwitcher" spacing="6"
                  style="-fx-background-color: rgba(255,255,255,0.03); -fx-background-radius: 14; -fx-padding: 5;">
                <Button fx:id="loginTab" text="Dang nhap"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        onAction="#onLoginTabClicked"
                        styleClass="tab-active"/>
                <Button fx:id="registerTab" text="Dang ky"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        onAction="#onRegisterTabClicked"
                        styleClass="tab-inactive"/>
            </HBox>

            <VBox fx:id="loginForm" spacing="18" managed="true" visible="true">


                <VBox spacing="6">
                    <Label text="Ten dang nhap" styleClass="form-label"/>
                    <TextField fx:id="loginUsername"
                               promptText="Nhap ten dang nhap"
                               styleClass="input-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Mat khau" styleClass="form-label"/>
                    <PasswordField fx:id="loginPassword"
                                   promptText="Nhap mat khau"
                                   styleClass="input-field"/>
                </VBox>

                <Label fx:id="loginError" text="" managed="false" visible="false"
                       styleClass="error-message"/>

                <Button fx:id="loginBtn" text="Dang nhap"
                        maxWidth="Infinity"
                        onAction="#onLoginSubmit"
                        styleClass="btn-primary">
                    <graphic>
                        <Region prefWidth="0" />
                    </graphic>
                </Button>

                <VBox spacing="4" alignment="CENTER" style="-fx-padding: 8 0 0 0;">
                    <Label text="Tai khoan test:" style="-fx-text-fill: #4b5563; -fx-font-size: 11;"/>
                    <HBox spacing="12" alignment="CENTER">
                        <Label text="admin / admin" style="-fx-text-fill: #6b7280; -fx-font-size: 11; -fx-padding: 3 10; -fx-background-color: rgba(255,255,255,0.03); -fx-background-radius: 6;"/>
                        <Label text="bidder / bidder" style="-fx-text-fill: #6b7280; -fx-font-size: 11; -fx-padding: 3 10; -fx-background-color: rgba(255,255,255,0.03); -fx-background-radius: 6;"/>
                        <Label text="seller / seller" style="-fx-text-fill: #6b7280; -fx-font-size: 11; -fx-padding: 3 10; -fx-background-color: rgba(255,255,255,0.03); -fx-background-radius: 6;"/>
                    </HBox>
                </VBox>
            </VBox>

            <VBox fx:id="registerForm" spacing="14" managed="false" visible="false">

                <VBox spacing="6">
                    <Label text="Ban muon tham gia voi tu cach" styleClass="form-label"/>
                    <HBox spacing="8">
                        <ToggleButton fx:id="roleBidder" text="⚡ Nguoi mua"
                                      HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                      selected="true"
                                      onAction="#onRoleChanged"
                                      styleClass="role-btn-active"/>
                        <ToggleButton fx:id="roleSeller" text="🏪 Nguoi ban"
                                      HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                      onAction="#onRoleChanged"
                                      styleClass="role-btn-inactive"/>
                    </HBox>
                </VBox>

                <VBox fx:id="storeNameBox" spacing="6" managed="false" visible="false">
                    <Label text="Ten cua hang" styleClass="form-label"/>
                    <TextField fx:id="regStoreName"
                               promptText="Nhap ten cua hang"
                               styleClass="input-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Ten dang nhap" styleClass="form-label"/>
                    <TextField fx:id="regUsername"
                               promptText="Nhap ten dang nhap"
                               styleClass="input-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Email" styleClass="form-label"/>
                    <TextField fx:id="regEmail"
                               promptText="Nhap email"
                               styleClass="input-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Mat khau" styleClass="form-label"/>
                    <PasswordField fx:id="regPassword"
                                   promptText="Nhap mat khau"
                                   styleClass="input-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Xac nhan mat khau" styleClass="form-label"/>
                    <PasswordField fx:id="regConfirmPassword"
                                   promptText="Nhap lai mat khau"
                                   styleClass="input-field"/>
                </VBox>

                <Label fx:id="regError" text="" managed="false" visible="false"
                       styleClass="error-message"/>

                <Button fx:id="regBtn" text="Tao tai khoan"
                        maxWidth="Infinity"
                        onAction="#onRegisterSubmit"
                        styleClass="btn-primary"/>

                <Label text="Bang cach dang ky, ban dong y voi Dieu khoan va Chinh sach bao mat"
                       wrapText="true"
                       textAlignment="CENTER"
                       style="-fx-text-fill: #374151; -fx-font-size: 11;"/>
            </VBox>
        </VBox>
    </HBox>
</StackPane>
