<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.Group?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.animation.*?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.team4.controller.LoginController"
           stylesheets="@style.css"
           id="loginRoot"
           prefWidth="1000" prefHeight="720"
           styleClass="login-bg">

    <HBox alignment="CENTER" spacing="0">

        <VBox id="leftPanel"
              prefWidth="580" minWidth="420" maxWidth="Infinity"
              HBox.hgrow="ALWAYS"
              alignment="CENTER_LEFT"
              spacing="28">
            <padding>
                <Insets top="64" right="64" bottom="64" left="64"/>
            </padding>

            <HBox spacing="14" alignment="CENTER_LEFT">
                <StackPane styleClass="brand-logo-mark"
                           prefWidth="52" prefHeight="52">
                    <Group scaleX="1.18" scaleY="1.18">
                        <Line startX="8" startY="31" endX="32" endY="31" styleClass="brand-logo-axis"/>
                        <Line startX="9" startY="27" endX="16" endY="21" styleClass="brand-logo-line"/>
                        <Line startX="16" startY="21" endX="23" endY="24" styleClass="brand-logo-line"/>
                        <Line startX="23" startY="24" endX="32" endY="12" styleClass="brand-logo-line"/>
                        <Line startX="32" startY="12" endX="31" endY="18" styleClass="brand-logo-arrow"/>
                        <Line startX="32" startY="12" endX="26" endY="13" styleClass="brand-logo-arrow"/>
                        <Circle centerX="9" centerY="27" radius="2.2" styleClass="brand-logo-node"/>
                        <Circle centerX="16" centerY="21" radius="2.2" styleClass="brand-logo-node"/>
                        <Circle centerX="23" centerY="24" radius="2.2" styleClass="brand-logo-node"/>
                    </Group>
                </StackPane>
                <VBox spacing="2">
                    <Label text="AuctionSpace" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2C2C2C;"/>
                    <Label text="Online Auction System" style="-fx-font-size: 13; -fx-text-fill: #555555;"/>
                </VBox>
            </HBox>

            <Region prefHeight="40" />

            <VBox spacing="8">
                <Label text="Welcome" styleClass="hero-title"/>
                <Label text="back" styleClass="hero-title-gradient"/>
                <Label text="Sign in to continue bidding and discover unique items from around the world."
                       wrapText="true" maxWidth="420" style="-fx-font-size: 16; -fx-text-fill: #555555; -fx-line-spacing: 4;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <HBox spacing="32" alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Label text="50K+" styleClass="stat-number"/>
                    <Label text="Users" styleClass="stat-label"/>
                </VBox>
                <Separator orientation="VERTICAL" styleClass="stat-sep"/>
                <VBox spacing="4">
                    <Label text="10K+" styleClass="stat-number"/>
                    <Label text="Items" styleClass="stat-label"/>
                </VBox>
                <Separator orientation="VERTICAL" styleClass="stat-sep"/>
                <VBox spacing="4">
                    <Label text="99%" styleClass="stat-number"/>
                    <Label text="Trust Rate" styleClass="stat-label"/>
                </VBox>
            </HBox>

            <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 20 0 0 0;">
                <Label text="UET-VNU" style="-fx-text-fill: #722F37; -fx-font-size: 12; -fx-font-weight: bold;"/>
                <Label text="-" style="-fx-text-fill: #9CA3AF;"/>
                <Label text="K70I - IT6" style="-fx-text-fill: #555555; -fx-font-size: 12;"/>
                <Label text="-" style="-fx-text-fill: #9CA3AF;"/>
                <Label text="Group 4" style="-fx-text-fill: #555555; -fx-font-size: 12;"/>
            </HBox>
        </VBox>

        <VBox id="rightPanel"
              prefWidth="480" minWidth="380" maxWidth="Infinity"
              HBox.hgrow="ALWAYS"
              alignment="CENTER"
              spacing="16"
              style="-fx-background-color: #FFFFFF;">
            <padding>
                <Insets top="32" right="56" bottom="32" left="56"/>
            </padding>

            <HBox id="mobileLogo" spacing="10" alignment="CENTER" managed="false" visible="false">
                <StackPane styleClass="brand-logo-mark"
                           prefWidth="40" prefHeight="40">
                    <Group>
                        <Line startX="8" startY="31" endX="32" endY="31" styleClass="brand-logo-axis"/>
                        <Line startX="9" startY="27" endX="16" endY="21" styleClass="brand-logo-line"/>
                        <Line startX="16" startY="21" endX="23" endY="24" styleClass="brand-logo-line"/>
                        <Line startX="23" startY="24" endX="32" endY="12" styleClass="brand-logo-line"/>
                        <Line startX="32" startY="12" endX="31" endY="18" styleClass="brand-logo-arrow"/>
                        <Line startX="32" startY="12" endX="26" endY="13" styleClass="brand-logo-arrow"/>
                        <Circle centerX="9" centerY="27" radius="2.2" styleClass="brand-logo-node"/>
                        <Circle centerX="16" centerY="21" radius="2.2" styleClass="brand-logo-node"/>
                        <Circle centerX="23" centerY="24" radius="2.2" styleClass="brand-logo-node"/>
                    </Group>
                </StackPane>
                <Label text="AuctionSpace" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </HBox>

            <HBox id="tabSwitcher" spacing="6"
                  style="-fx-background-color: #F3F4F6; -fx-background-radius: 14; -fx-padding: 5;">
                <Button fx:id="loginTab" text="Login"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        onAction="#onLoginTabClicked"
                        styleClass="tab-active"/>
                <Button fx:id="registerTab" text="Register"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity"
                        onAction="#onRegisterTabClicked"
                        styleClass="tab-inactive"/>
            </HBox>

            <VBox fx:id="loginForm" spacing="14" managed="true" visible="true">

                <VBox spacing="6">
                    <Label text="Username" styleClass="form-label"/>
                    <TextField fx:id="loginUsername"
                               promptText="Enter username"
                               styleClass="input-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Password" styleClass="form-label"/>
                    <PasswordField fx:id="loginPassword"
                                   promptText="Enter password"
                                   styleClass="input-field"/>
                </VBox>

                <Hyperlink fx:id="toggleAdminCodeLink"
                           text="Login as admin?"
                           onAction="#onToggleAdminCode"
                           styleClass="admin-toggle-link"/>

                <VBox fx:id="adminCodeBox" spacing="6" managed="false" visible="false">
                    <Label text="Enter Admin Code" styleClass="form-label"/>
                    <PasswordField fx:id="loginAdminCode"
                                   promptText="Required for admin staff only"
                                   styleClass="input-field"/>
                </VBox>

                <Label fx:id="loginError" text="" managed="false" visible="false"
                       styleClass="error-message"/>

                <Button fx:id="loginBtn" text="Login"
                        maxWidth="Infinity"
                        onAction="#onLoginSubmit"
                        defaultButton="true"
                        styleClass="btn-primary">
                    <graphic>
                        <Region prefWidth="0" />
                    </graphic>
                </Button>
            </VBox>

            <VBox fx:id="registerForm" spacing="14" managed="false" visible="false">

                <VBox spacing="6">
                    <Label text="Join as" styleClass="form-label"/>
                    <fx:define>
                        <ToggleGroup fx:id="roleGroup"/>
                    </fx:define>

                    <HBox spacing="8">
                        <ToggleButton fx:id="roleBidder" text="Bidder"
                                      toggleGroup="$roleGroup"
                                      HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                      selected="true"
                                      onAction="#onRoleChanged"
                                      styleClass="role-btn-active"/>
                        <ToggleButton fx:id="roleSeller" text="Seller"
                                      toggleGroup="$roleGroup"
                                      HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                      onAction="#onRoleChanged"
                                      styleClass="role-btn-inactive"/>
                    </HBox>
                </VBox>

                <VBox fx:id="storeNameBox" spacing="6" managed="false" visible="false">
                    <Label text="Store Name" styleClass="form-label"/>
                    <TextField fx:id="regStoreName"
                               promptText="Enter store name"
                               styleClass="input-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Username" styleClass="form-label"/>
                    <TextField fx:id="regUsername"
                               promptText="Enter username"
                               styleClass="input-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Email" styleClass="form-label"/>
                    <TextField fx:id="regEmail"
                               promptText="Enter email"
                               styleClass="input-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Phone Number" styleClass="form-label"/>
                    <TextField fx:id="regPhone"
                               promptText="Enter phone number (e.g. 0987654321)"
                               styleClass="input-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Password" styleClass="form-label"/>
                    <PasswordField fx:id="regPassword"
                                   promptText="Enter password"
                                   styleClass="input-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Confirm Password" styleClass="form-label"/>
                    <PasswordField fx:id="regConfirmPassword"
                                   promptText="Confirm password"
                                   styleClass="input-field"/>
                </VBox>

                <Label fx:id="regError" text="" managed="false" visible="false"
                       styleClass="error-message"/>

                <Button fx:id="regBtn" text="Create Account"
                        maxWidth="Infinity"
                        onAction="#onRegisterSubmit"
                        styleClass="btn-primary"/>

                <TextFlow textAlignment="CENTER">
                    <Text text="By registering, you agree to our "
                          style="-fx-font-size: 11; -fx-fill: #555555;"/>
                    <Hyperlink fx:id="termsLink" text="Terms and Privacy Policy"
                               onAction="#onTermsClicked"
                               style="-fx-font-size: 11; -fx-text-fill: #722F37;
                      -fx-border-color: transparent; -fx-padding: 0;
                      -fx-underline: true;"/>
                </TextFlow>
            </VBox>
        </VBox>
    </HBox>
</StackPane>
