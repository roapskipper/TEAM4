<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>

<VBox prefWidth="1100" spacing="18" style="-fx-background-color: transparent;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.team4.controller.SellerProductsController">

    <HBox spacing="14">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="totalProducts" styleClass="stat-number-neutral" text="24" />
            <Label styleClass="muted-text" text="Total Products" />
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="activeAuctions" styleClass="stat-number-accent" text="8" />
            <Label styleClass="muted-text" text="Bidding" />
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="pendingProducts" styleClass="stat-number-muted" text="3" />
            <Label styleClass="muted-text" text="Pending" />
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="soldProducts" styleClass="stat-number-neutral" text="156" />
            <Label styleClass="muted-text" text="Sold" />
        </VBox>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <TextField fx:id="searchField" prefWidth="300" promptText="Search products..." styleClass="admin-input" />
        <ComboBox fx:id="categoryFilter" prefWidth="190" promptText="All" styleClass="admin-combo" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="addProductBtn" minWidth="140" onAction="#onAddProduct" styleClass="btn-primary" text="Add Product" />
    </HBox>

    <TitledPane expanded="true" text="Product Registration Rules" styleClass="rules-pane">
        <VBox spacing="12" style="-fx-padding: 8 14 12 14;">
            <!-- COMMON -->
            <VBox spacing="8">
                <Label text="COMMON (REQUIRED)" style="-fx-font-weight: bold; -fx-text-fill: #555555; -fx-font-size: 11px;"/>
                <FlowPane hgap="10" vgap="10">
                    <Label text="Name (maximum 100 characters)" styleClass="rule-pill-required" />
                    <Label text="Category" styleClass="rule-pill-required" />
                    <Label text="Starting price (greater than 0 VND), minimum: 50,000 VND" styleClass="rule-pill-required" />
                    <Label text="Description (maximum 500 characters)" styleClass="rule-pill-required" />
                </FlowPane>
            </VBox>

            <!-- BY CATEGORY -->
            <VBox spacing="8">
                <Label text="BY CATEGORY" style="-fx-font-weight: bold; -fx-text-fill: #555555; -fx-font-size: 11px;"/>
                <GridPane hgap="12" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.34"/>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                    </columnConstraints>
                    <!-- Art -->
                    <VBox styleClass="category-panel rules-category-panel" spacing="8" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Art" style="-fx-font-weight: bold; -fx-text-fill: #2C2C2C;"/>
                        <FlowPane hgap="8" vgap="8">
                            <Label text="Medium" styleClass="rule-pill-required" />
                            <Label text="Artist" styleClass="rule-pill-optional" />
                            <Label text="Year" styleClass="rule-pill-optional" />
                            <Label text="Dimensions" styleClass="rule-pill-optional" />
                        </FlowPane>
                    </VBox>
                    
                    <!-- Collectible -->
                    <VBox styleClass="category-panel rules-category-panel" spacing="8" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Collectible" style="-fx-font-weight: bold; -fx-text-fill: #2C2C2C;"/>
                        <FlowPane hgap="8" vgap="8">
                            <Label text="Rarity" styleClass="rule-pill-required" />
                            <Label text="Condition" styleClass="rule-pill-required" />
                            <Label text="Year" styleClass="rule-pill-optional" />
                            <Label text="Origin" styleClass="rule-pill-optional" />
                            <Label text="Certificate" styleClass="rule-pill-optional" />
                        </FlowPane>
                    </VBox>
                    
                    <!-- Electronics -->
                    <VBox styleClass="category-panel rules-category-panel" spacing="8" maxWidth="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="Electronics" style="-fx-font-weight: bold; -fx-text-fill: #2C2C2C;"/>
                        <FlowPane hgap="8" vgap="8">
                            <Label text="Condition" styleClass="rule-pill-required" />
                            <Label text="Warranty" styleClass="rule-pill-required" />
                            <Label text="Brand" styleClass="rule-pill-optional" />
                            <Label text="Model" styleClass="rule-pill-optional" />
                        </FlowPane>
                    </VBox>
                    
                    <!-- Fashion -->
                    <VBox styleClass="category-panel rules-category-panel" spacing="8" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Fashion" style="-fx-font-weight: bold; -fx-text-fill: #2C2C2C;"/>
                        <FlowPane hgap="8" vgap="8">
                            <Label text="Size" styleClass="rule-pill-required" />
                            <Label text="Condition" styleClass="rule-pill-required" />
                            <Label text="Gender" styleClass="rule-pill-optional" />
                            <Label text="Brand" styleClass="rule-pill-optional" />
                            <Label text="Material" styleClass="rule-pill-optional" />
                            <Label text="Color" styleClass="rule-pill-optional" />
                        </FlowPane>
                    </VBox>

                    <!-- Vehicle -->
                    <VBox styleClass="category-panel rules-category-panel" spacing="8" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Vehicle" style="-fx-font-weight: bold; -fx-text-fill: #2C2C2C;"/>
                        <FlowPane hgap="8" vgap="8">
                            <Label text="Engine" styleClass="rule-pill-required" />
                            <Label text="Transmission" styleClass="rule-pill-required" />
                            <Label text="Odometer" styleClass="rule-pill-required" />
                            <Label text="Manufacturing year" styleClass="rule-pill-optional" />
                            <Label text="Brand" styleClass="rule-pill-optional" />
                            <Label text="Model" styleClass="rule-pill-optional" />
                        </FlowPane>
                    </VBox>
                </GridPane>
            </VBox>
            
            <!-- Legend -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 6 0 0 0;">
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <Label style="-fx-background-color: #B91C1C; -fx-min-width: 6; -fx-min-height: 6; -fx-max-width: 6; -fx-max-height: 6; -fx-background-radius: 3;"/>
                    <Label text="Required" style="-fx-text-fill: #555555; -fx-font-size: 11px;"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <Label style="-fx-background-color: #9CA3AF; -fx-min-width: 6; -fx-min-height: 6; -fx-max-width: 6; -fx-max-height: 6; -fx-background-radius: 3;"/>
                    <Label text="Optional" style="-fx-text-fill: #555555; -fx-font-size: 11px;"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label text="Click &quot;Add Product&quot; to open the full form for these fields." style="-fx-text-fill: #555555; -fx-font-size: 11px;"/>
            </HBox>
        </VBox>
    </TitledPane>

    <VBox minHeight="420" styleClass="admin-card table-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="productsTable" fixedCellSize="44" minHeight="360" styleClass="admin-table products-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colProduct" minWidth="190" prefWidth="270" text="Product" />
                <TableColumn fx:id="colCategory" minWidth="100" prefWidth="125" text="Category" />
                <TableColumn fx:id="colStartPrice" minWidth="130" prefWidth="150" text="Start Price" />
                <TableColumn fx:id="colCurrentPrice" minWidth="130" prefWidth="150" text="Current Price" />
                <TableColumn fx:id="colStatus" minWidth="95" prefWidth="115" text="Status" />
                <TableColumn fx:id="colDate" minWidth="95" prefWidth="115" text="Date" />
                <TableColumn fx:id="colAction" minWidth="150" prefWidth="170" text="Action" />
            </columns>
        </TableView>
    </VBox>
</VBox>
