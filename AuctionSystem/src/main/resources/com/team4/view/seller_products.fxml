<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="1100" spacing="20" style="-fx-background-color: transparent;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.team4.controller.SellerProductsController">

    <HBox spacing="14">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="totalProducts" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: white;" text="24" />
            <Label style="-fx-font-size: 12; -fx-text-fill: #6b7280;" text="Total Products" />
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="activeAuctions" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #22c55e;" text="8" />
            <Label style="-fx-font-size: 12; -fx-text-fill: #6b7280;" text="Bidding" />
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="pendingProducts" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #eab308;" text="3" />
            <Label style="-fx-font-size: 12; -fx-text-fill: #6b7280;" text="Pending" />
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="soldProducts" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #3b82f6;" text="156" />
            <Label style="-fx-font-size: 12; -fx-text-fill: #6b7280;" text="Sold" />
        </VBox>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <TextField fx:id="searchField" prefWidth="280" promptText="🔍 Search..." styleClass="admin-input" />
        <ComboBox fx:id="categoryFilter" prefWidth="180" promptText="Tat ca danh muc" styleClass="admin-combo" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="addProductBtn" onAction="#onAddProduct" styleClass="btn-primary" text="➕ Add Product" />
    </HBox>

    <VBox styleClass="admin-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="productsTable" styleClass="admin-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colProduct" prefWidth="300" text="Product" />
                <TableColumn fx:id="colCategory" prefWidth="120" text="Category" />
                <TableColumn fx:id="colStartPrice" prefWidth="130" text="Start Price" />
                <TableColumn fx:id="colCurrentPrice" prefWidth="130" text="Current Price" />
                <TableColumn fx:id="colStatus" prefWidth="110" text="Status" />
                <TableColumn fx:id="colDate" prefWidth="100" text="Date" />
                <TableColumn fx:id="colAction" prefWidth="120" text="Action" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>
