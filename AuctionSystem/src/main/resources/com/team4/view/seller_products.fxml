<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.team4.controller.SellerProductsController"
      spacing="20"
      style="-fx-background-color: transparent;"
      prefWidth="1100">

    <HBox spacing="14">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="totalProducts" text="24" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Total Products" style="-fx-font-size: 12; -fx-text-fill: #6b7280;"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="activeAuctions" text="8" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #22c55e;"/>
            <Label text="Bidding" style="-fx-font-size: 12; -fx-text-fill: #6b7280;"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="pendingProducts" text="3" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #eab308;"/>
            <Label text="Pending" style="-fx-font-size: 12; -fx-text-fill: #6b7280;"/>
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="soldProducts" text="156" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
            <Label text="Sold" style="-fx-font-size: 12; -fx-text-fill: #6b7280;"/>
        </VBox>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="🔍 Search..." styleClass="admin-input" prefWidth="280"/>
        <ComboBox fx:id="categoryFilter" promptText="Tat ca danh muc" styleClass="admin-combo" prefWidth="180"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addProductBtn" text="➕ Add Product" onAction="#onAddProduct" styleClass="btn-primary"/>
    </HBox>

    <VBox styleClass="admin-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="productsTable" VBox.vgrow="ALWAYS" styleClass="admin-table">
            <columns>
                <TableColumn fx:id="colProduct" text="Product" prefWidth="300"/>
                <TableColumn fx:id="colCategory" text="Category" prefWidth="120"/>
                <TableColumn fx:id="colStartPrice" text="Start Price" prefWidth="130"/>
                <TableColumn fx:id="colCurrentPrice" text="Current Price" prefWidth="130"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="110"/>
                <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
                <TableColumn fx:id="colAction" text="Action" prefWidth="120"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>