<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="1100" spacing="18" style="-fx-background-color: transparent;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.team4.controller.SellerProductsController">

    <HBox spacing="14">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="totalProducts" styleClass="stat-number-neutral" text="24" />
            <Label styleClass="muted-text" text="Total Products" />
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="activeAuctions" styleClass="stat-number-accent" text="8" />
            <Label styleClass="muted-text" text="Bidding" />
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="pendingProducts" styleClass="stat-number-muted" text="3" />
            <Label styleClass="muted-text" text="Pending" />
        </VBox>
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <Label fx:id="soldProducts" styleClass="stat-number-neutral" text="156" />
            <Label styleClass="muted-text" text="Sold" />
        </VBox>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <TextField fx:id="searchField" prefWidth="300" promptText="Search products..." styleClass="admin-input" />
        <ComboBox fx:id="categoryFilter" prefWidth="190" promptText="All Categories" styleClass="admin-combo" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="addProductBtn" minWidth="140" onAction="#onAddProduct" styleClass="btn-primary" text="Đăng sản phẩm" />
    </HBox>

    <TitledPane expanded="false" styleClass="rules-pane">
        <graphic>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="ℹ" styleClass="rules-icon" />
                <Label text="Quy tắc đăng sản phẩm (đồng bộ với hệ thống)" styleClass="rules-title" />
            </HBox>
        </graphic>
        <content>
            <VBox spacing="16" styleClass="rules-content">
                <VBox spacing="10">
                    <Label text="CHUNG (BẮT BUỘC)" styleClass="rules-section-title" />
                    <FlowPane hgap="8" vgap="8">
                        <HBox styleClass="rule-pill, rule-pill-req">
                            <Label text="Tên" />
                            <Label text="≤100 ký tự" styleClass="rule-pill-muted" />
                        </HBox>
                        <HBox styleClass="rule-pill, rule-pill-req">
                            <Label text="Danh mục" />
                        </HBox>
                        <HBox styleClass="rule-pill, rule-pill-req">
                            <Label text="Giá khởi điểm" />
                            <Label text="≥0, min 50.000 VND" styleClass="rule-pill-muted" />
                        </HBox>
                        <HBox styleClass="rule-pill, rule-pill-req">
                            <Label text="Mô tả" />
                            <Label text="≤500 ký tự" styleClass="rule-pill-muted" />
                        </HBox>
                    </FlowPane>
                </VBox>

                <VBox spacing="10">
                    <Label text="THEO DANH MỤC" styleClass="rules-section-title" />
                    <FlowPane hgap="12" vgap="12">
                        <VBox styleClass="category-rule-card">
                            <Label text="🎨 Nghệ thuật" styleClass="category-rule-title" />
                            <FlowPane hgap="6" vgap="6">
                                <Label text="Chất liệu" styleClass="rule-pill, rule-pill-req" />
                                <Label text="Tác giả" styleClass="rule-pill, rule-pill-opt" />
                                <Label text="Năm" styleClass="rule-pill, rule-pill-opt" />
                                <Label text="Kích thước" styleClass="rule-pill, rule-pill-opt" />
                            </FlowPane>
                        </VBox>
                        <VBox styleClass="category-rule-card">
                            <Label text="🏺 Đồ sưu tầm" styleClass="category-rule-title" />
                            <FlowPane hgap="6" vgap="6">
                                <Label text="Độ hiếm" styleClass="rule-pill, rule-pill-req" />
                                <Label text="Tình trạng" styleClass="rule-pill, rule-pill-req" />
                                <Label text="Năm" styleClass="rule-pill, rule-pill-opt" />
                                <Label text="Xuất xứ" styleClass="rule-pill, rule-pill-opt" />
                                <Label text="Chứng chỉ" styleClass="rule-pill, rule-pill-opt" />
                            </FlowPane>
                        </VBox>
                        <VBox styleClass="category-rule-card">
                            <Label text="📱 Điện tử" styleClass="category-rule-title" />
                            <FlowPane hgap="6" vgap="6">
                                <Label text="Tình trạng" styleClass="rule-pill, rule-pill-req" />
                                <Label text="Bảo hành" styleClass="rule-pill, rule-pill-req" />
                                <Label text="Thương hiệu" styleClass="rule-pill, rule-pill-opt" />
                                <Label text="Model" styleClass="rule-pill, rule-pill-opt" />
                            </FlowPane>
                        </VBox>
                        <VBox styleClass="category-rule-card">
                            <Label text="👕 Thời trang" styleClass="category-rule-title" />
                            <FlowPane hgap="6" vgap="6">
                                <Label text="Kích cỡ" styleClass="rule-pill, rule-pill-req" />
                                <Label text="Tình trạng" styleClass="rule-pill, rule-pill-req" />
                                <Label text="Đối tượng" styleClass="rule-pill, rule-pill-req" />
                                <Label text="Thương hiệu" styleClass="rule-pill, rule-pill-opt" />
                                <Label text="Chất liệu" styleClass="rule-pill, rule-pill-opt" />
                                <Label text="Màu" styleClass="rule-pill, rule-pill-opt" />
                            </FlowPane>
                        </VBox>
                        <VBox styleClass="category-rule-card">
                            <Label text="🚗 Phương tiện" styleClass="category-rule-title" />
                            <FlowPane hgap="6" vgap="6">
                                <Label text="Động cơ" styleClass="rule-pill, rule-pill-req" />
                                <Label text="Hộp số" styleClass="rule-pill, rule-pill-req" />
                                <Label text="Số km" styleClass="rule-pill, rule-pill-req" />
                                <Label text="Năm SX" styleClass="rule-pill, rule-pill-opt" />
                                <Label text="Thương hiệu" styleClass="rule-pill, rule-pill-opt" />
                                <Label text="Model" styleClass="rule-pill, rule-pill-opt" />
                            </FlowPane>
                        </VBox>
                    </FlowPane>
                </VBox>
                
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="rules-legend">
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Region styleClass="legend-dot, legend-dot-req" />
                        <Label text="Bắt buộc" styleClass="legend-text" />
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Region styleClass="legend-dot, legend-dot-opt" />
                        <Label text="Tùy chọn" styleClass="legend-text" />
                    </HBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="Nhấn «Đăng sản phẩm» để mở form đầy đủ các trường trên." styleClass="legend-text" />
                </HBox>
            </VBox>
        </content>
    </TitledPane>

    <VBox minHeight="420" styleClass="admin-card table-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="productsTable" fixedCellSize="44" minHeight="360" styleClass="admin-table products-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colProduct" minWidth="220" prefWidth="280" text="Product" />
                <TableColumn fx:id="colCategory" minWidth="110" prefWidth="130" text="Category" />
                <TableColumn fx:id="colStartPrice" minWidth="145" prefWidth="160" text="Start Price" />
                <TableColumn fx:id="colCurrentPrice" minWidth="145" prefWidth="160" text="Current Price" />
                <TableColumn fx:id="colStatus" minWidth="110" prefWidth="120" text="Status" />
                <TableColumn fx:id="colDate" minWidth="105" prefWidth="120" text="Date" />
                <TableColumn fx:id="colAction" minWidth="85" prefWidth="95" text="Action" />
            </columns>
        </TableView>
    </VBox>
</VBox>
