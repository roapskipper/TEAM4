<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" prefWidth="580" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.team4.controller.AddProductDialogController"
      stylesheets="@style.css"
      styleClass="dialog-root">
    <padding>
        <Insets top="20" right="20" bottom="16" left="20"/>
    </padding>

    <Label text="Add New Product" styleClass="dialog-title"/>
    <Label text="Enter the common product details and the category-specific details. Fields marked with * are required."
           styleClass="dialog-help" wrapText="true"/>

    <ScrollPane fitToWidth="true" prefViewportHeight="520" styleClass="dialog-scroll" VBox.vgrow="ALWAYS">
        <VBox spacing="14">
            <padding>
                <Insets top="8" right="4" bottom="8" left="4"/>
            </padding>

            <!-- Common fields -->
            <Label text="1. Common Information (All Products)" styleClass="form-section-title"/>
            <Label text="Product Name *" styleClass="form-label"/>
            <TextField fx:id="nameField" promptText="Required, maximum 100 characters (DB: 255)" styleClass="input-field"/>

            <Label text="Category *" styleClass="form-label"/>
            <ComboBox fx:id="categoryBox" maxWidth="Infinity" promptText="Select a category" styleClass="admin-combo"/>

            <Label text="Starting Price (VND) *" styleClass="form-label"/>
            <TextField fx:id="priceField" promptText="Number >= 0; minimum 50,000; multiple of 1,000" styleClass="input-field"/>
            <Label text="Category price limits: Electronics 5B, Vehicle 10B, Art/Collectible 2B, Fashion 500M."
                   styleClass="dialog-help" wrapText="true"/>

            <Label text="Description *" styleClass="form-label"/>
            <TextArea fx:id="descArea" prefRowCount="3" wrapText="true"
                      promptText="Required, maximum 500 UI characters (DB: 2000)" styleClass="input-field"/>

            <!-- Category-specific -->
            <Label text="2. Category-Specific Information" styleClass="form-section-title"/>
            <Label fx:id="categoryHintLabel" styleClass="dialog-help" wrapText="true"/>

            <!-- Art -->
            <VBox fx:id="artPanel" spacing="8" styleClass="category-panel">
                <Label text="Art" styleClass="form-section-subtitle"/>
                <Label text="Medium *" styleClass="form-label"/>
                <ComboBox fx:id="artMediumBox" maxWidth="Infinity" promptText="Select a medium" styleClass="admin-combo"/>
                <Label text="Artist (optional; leave blank for Unknown)" styleClass="form-label"/>
                <TextField fx:id="artArtistField" promptText="Artist" styleClass="input-field"/>
                <Label text="Creation Year (optional; 0 = unknown, from -3000 to current year)" styleClass="form-label"/>
                <TextField fx:id="artYearField" promptText="Example: 1890 or 0" styleClass="input-field"/>
                <Label text="Dimensions (optional, example: 30x40 cm)" styleClass="form-label"/>
                <TextField fx:id="artDimensionsField" promptText="30x40 cm" styleClass="input-field"/>
            </VBox>

            <!-- Collectible -->
            <VBox fx:id="collectiblePanel" spacing="8" styleClass="category-panel" visible="false" managed="false">
                <Label text="Collectible" styleClass="form-section-subtitle"/>
                <Label text="Rarity *" styleClass="form-label"/>
                <ComboBox fx:id="collectibleRarityBox" maxWidth="Infinity" promptText="Select rarity" styleClass="admin-combo"/>
                <Label text="Condition *" styleClass="form-label"/>
                <ComboBox fx:id="collectibleConditionBox" maxWidth="Infinity" promptText="Select condition" styleClass="admin-combo"/>
                <Label text="Year of Origin (optional, 0 = unknown)" styleClass="form-label"/>
                <TextField fx:id="collectibleYearField" promptText="0 or a specific year" styleClass="input-field"/>
                <Label text="Origin (optional; leave blank for Unknown)" styleClass="form-label"/>
                <TextField fx:id="collectibleOriginField" promptText="Country / region" styleClass="input-field"/>
                <CheckBox fx:id="collectibleCertCheck" text="Has certificate (optional)"/>
            </VBox>

            <!-- Electronics -->
            <VBox fx:id="electronicsPanel" spacing="8" styleClass="category-panel" visible="false" managed="false">
                <Label text="Electronics" styleClass="form-section-subtitle"/>
                <Label text="Condition *" styleClass="form-label"/>
                <ComboBox fx:id="electronicsConditionBox" maxWidth="Infinity" promptText="Select condition" styleClass="admin-combo"/>
                <Label text="Warranty Months *" styleClass="form-label"/>
                <TextField fx:id="electronicsWarrantyField" promptText=">= 0" styleClass="input-field"/>
                <Label text="Brand (optional; leave blank for Unknown)" styleClass="form-label"/>
                <TextField fx:id="electronicsBrandField" promptText="Brand" styleClass="input-field"/>
                <Label text="Model (optional; leave blank for Unknown)" styleClass="form-label"/>
                <TextField fx:id="electronicsModelField" promptText="Model name" styleClass="input-field"/>
                <CheckBox fx:id="electronicsFunctionalCheck" text="Fully functional (optional)" selected="true"/>
            </VBox>

            <!-- Fashion -->
            <VBox fx:id="fashionPanel" spacing="8" styleClass="category-panel" visible="false" managed="false">
                <Label text="Fashion" styleClass="form-section-subtitle"/>
                <Label text="Size *" styleClass="form-label"/>
                <ComboBox fx:id="fashionSizeBox" maxWidth="Infinity" promptText="XS, S, M, L, XL..." styleClass="admin-combo"/>
                <Label text="Condition *" styleClass="form-label"/>
                <ComboBox fx:id="fashionConditionBox" maxWidth="Infinity" promptText="Select condition" styleClass="admin-combo"/>
                <Label text="Gender *" styleClass="form-label"/>
                <ComboBox fx:id="fashionGenderBox" maxWidth="Infinity" styleClass="admin-combo"/>
                <Label text="Brand (optional; leave blank for Unknown)" styleClass="form-label"/>
                <TextField fx:id="fashionBrandField" promptText="Brand" styleClass="input-field"/>
                <Label text="Material (optional)" styleClass="form-label"/>
                <TextField fx:id="fashionMaterialField" promptText="Material" styleClass="input-field"/>
                <Label text="Color (optional)" styleClass="form-label"/>
                <TextField fx:id="fashionColorField" promptText="Color" styleClass="input-field"/>
                <CheckBox fx:id="fashionAuthenticCheck" text="Authentic item (optional)"/>
            </VBox>

            <!-- Vehicle -->
            <VBox fx:id="vehiclePanel" spacing="8" styleClass="category-panel" visible="false" managed="false">
                <Label text="Vehicle" styleClass="form-section-subtitle"/>
                <Label text="Engine Type *" styleClass="form-label"/>
                <ComboBox fx:id="vehicleEngineBox" maxWidth="Infinity" promptText="Gasoline, Electric, Diesel..." styleClass="admin-combo"/>
                <Label text="Transmission *" styleClass="form-label"/>
                <ComboBox fx:id="vehicleTransmissionBox" maxWidth="Infinity" styleClass="admin-combo"/>
                <Label text="Odometer (km) *" styleClass="form-label"/>
                <TextField fx:id="vehicleOdoField" promptText="0 - 1,000,000 km" styleClass="input-field"/>
                <Label text="Manufacturing Year (optional, 1886 - current year; 0 = unknown)" styleClass="form-label"/>
                <TextField fx:id="vehicleYearField" promptText="Example: 2020 or 0" styleClass="input-field"/>
                <Label text="Brand (optional; leave blank for Unknown)" styleClass="form-label"/>
                <TextField fx:id="vehicleBrandField" promptText="Vehicle brand" styleClass="input-field"/>
                <Label text="Model (optional; leave blank for Unknown)" styleClass="form-label"/>
                <TextField fx:id="vehicleModelField" promptText="Vehicle model" styleClass="input-field"/>
                <Label text="Color (optional)" styleClass="form-label"/>
                <TextField fx:id="vehicleColorField" promptText="Color" styleClass="input-field"/>
                <CheckBox fx:id="vehicleLegalCheck" text="Has legal papers (optional)"/>
            </VBox>
        </VBox>
    </ScrollPane>

    <Label fx:id="errorLabel" styleClass="error-message" visible="false" managed="false" wrapText="true"/>
    <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="dialog-actions">
        <Button text="Cancel" onAction="#onCancel" styleClass="btn-secondary" minWidth="96"/>
        <Button text="Save Product" onAction="#onSave" styleClass="btn-primary" minWidth="140"/>
    </HBox>
</VBox>
