<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" prefWidth="400" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.team4.controller.AddProductDialogController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Add New Product" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    
    <Label text="Product Name *"/>
    <TextField fx:id="nameField" promptText="Enter product name (max 100 chars)"/>
    
    <Label text="Category *"/>
    <ComboBox fx:id="categoryBox" prefWidth="360" promptText="Select a category"/>
    
    <Label text="Starting Price *"/>
    <TextField fx:id="priceField" promptText="Min 50000 (multiples of 1000)"/>
    <Label text="Min: 50K VND. Multiple of 1,000. Max: Electronics (5B), Vehicle (10B), Art/Collectible (2B), Fashion (500M)." style="-fx-font-size: 10px; -fx-text-fill: gray;" wrapText="true"/>
    
    <Label text="Description"/>
    <TextArea fx:id="descArea" prefRowCount="4" wrapText="true" promptText="Optional description (max 500 chars)"/>
    
    <Label fx:id="errorLabel" textFill="red" visible="false"/>
    
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#onCancel" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
        <Button text="Save Product" onAction="#onSave" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
    </HBox>
</VBox>
