<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<VBox prefWidth="1100" spacing="24" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.team4.controller.AdminDashboardController">

    <HBox alignment="CENTER_LEFT">
        <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Dashboard Overview" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="refreshButton" text="Refresh" onAction="#onRefresh" styleClass="admin-button-primary" />
    </HBox>

    <HBox spacing="16" styleClass="dashboard-stat-row">
        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="44" prefWidth="44" styleClass="stat-icon-primary">
                    <Label style="-fx-font-size: 14; -fx-font-weight: bold;" text="U" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="totalUsersLabel" styleClass="stat-number-neutral" style="-fx-font-size: 24;" text="0" />
                    <Label styleClass="muted-text" text="Total Users" />
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="44" prefWidth="44" styleClass="stat-icon-success">
                    <Label style="-fx-font-size: 14; -fx-font-weight: bold;" text="A" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="totalAuctionsLabel" styleClass="stat-number-neutral" style="-fx-font-size: 24;" text="0" />
                    <Label styleClass="muted-text" text="Total Auctions" />
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="44" prefWidth="44" styleClass="stat-icon-warning">
                    <Label style="-fx-font-size: 14; -fx-font-weight: bold;" text="R" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="activeAuctionsLabel" styleClass="stat-number-neutral" style="-fx-font-size: 24;" text="0" />
                    <Label styleClass="muted-text" text="Running Auctions" />
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="44" prefWidth="44" styleClass="stat-icon-danger">
                    <Label style="-fx-font-size: 14; -fx-font-weight: bold;" text="P" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="pendingAuctionsLabel" styleClass="stat-number-neutral" style="-fx-font-size: 24;" text="0" />
                    <Label styleClass="muted-text" text="Pending Auctions" />
                </VBox>
            </HBox>
        </VBox>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox prefWidth="500" styleClass="admin-card" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="Registration Statistics" />
            <BarChart fx:id="regChart" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                <xAxis><CategoryAxis label="Month" style="-fx-tick-label-fill: #555555;" /></xAxis>
                <yAxis><NumberAxis label="Users" style="-fx-tick-label-fill: #555555;" /></yAxis>
            </BarChart>
        </VBox>

        <VBox prefWidth="500" spacing="16" styleClass="admin-card dashboard-command-card" HBox.hgrow="ALWAYS">
            <VBox spacing="4">
                <Label styleClass="section-title" text="Review Center" />
                <Label styleClass="muted-text" text="Live work queue based on current users and auctions." />
            </VBox>

            <HBox spacing="12">
                <VBox spacing="4" styleClass="dashboard-insight-card dashboard-insight-primary" HBox.hgrow="ALWAYS">
                    <Label fx:id="pendingReviewCount" text="0" styleClass="dashboard-insight-number" />
                    <Label text="Pending Review" styleClass="dashboard-insight-title" />
                    <Label text="Auctions waiting for approval" styleClass="dashboard-insight-desc" wrapText="true" />
                </VBox>

                <VBox spacing="4" styleClass="dashboard-insight-card" HBox.hgrow="ALWAYS">
                    <Label fx:id="liveAuctionCount" text="0" styleClass="dashboard-insight-number" />
                    <Label text="Running Now" styleClass="dashboard-insight-title" />
                    <Label text="Auctions currently live" styleClass="dashboard-insight-desc" wrapText="true" />
                </VBox>
            </HBox>

            <VBox spacing="10" styleClass="dashboard-action-panel">
                <Label text="Actions" styleClass="dashboard-action-heading" />
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>

                    <Button text="Review Pending" onAction="#onViewPendingAuctions"
                            maxWidth="Infinity" styleClass="admin-button-primary"
                            GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Button text="Manage Users" onAction="#onManageUsers"
                            maxWidth="Infinity" styleClass="admin-button-secondary"
                            GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <Button text="View Auctions" onAction="#onManageAuctions"
                            maxWidth="Infinity" styleClass="admin-button-secondary"
                            GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Button text="Refresh Data" onAction="#onRefresh"
                            maxWidth="Infinity" styleClass="admin-button-secondary"
                            GridPane.columnIndex="1" GridPane.rowIndex="1" />
                </GridPane>
            </VBox>
        </VBox>
    </HBox>
</VBox>
