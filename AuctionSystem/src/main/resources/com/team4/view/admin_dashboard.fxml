<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<VBox prefWidth="1100" spacing="24" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.team4.controller.AdminDashboardController">

    <HBox alignment="CENTER_LEFT">
        <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Dashboard Overview" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="refreshButton" text="Refresh" onAction="#onRefresh" styleClass="admin-button-primary" />
    </HBox>

    <HBox spacing="16">
        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="44" prefWidth="44" styleClass="stat-icon-primary">
                    <Label style="-fx-font-size: 20;" text="👥" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="totalUsersLabel" styleClass="stat-number-neutral" style="-fx-font-size: 24;" text="0" />
                    <Label styleClass="muted-text" text="Total Users" />
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="44" prefWidth="44" styleClass="stat-icon-success">
                    <Label style="-fx-font-size: 20;" text="📦" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="totalAuctionsLabel" styleClass="stat-number-neutral" style="-fx-font-size: 24;" text="0" />
                    <Label styleClass="muted-text" text="Total Auctions" />
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="44" prefWidth="44" styleClass="stat-icon-warning">
                    <Label style="-fx-font-size: 20;" text="🔥" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="activeAuctionsLabel" styleClass="stat-number-neutral" style="-fx-font-size: 24;" text="0" />
                    <Label styleClass="muted-text" text="Active Auctions" />
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="44" prefWidth="44" styleClass="stat-icon-success">
                    <Label style="-fx-font-size: 20;" text="💰" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="totalRevenueLabel" styleClass="stat-number-neutral" style="-fx-font-size: 24;" text="0" />
                    <Label styleClass="muted-text" text="Total Revenue" />
                </VBox>
            </HBox>
        </VBox>
    </HBox>

    <HBox spacing="16">
        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="44" prefWidth="44" styleClass="stat-icon-primary">
                    <Label style="-fx-font-size: 20;" text="💳" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="totalTransactionsLabel" styleClass="stat-number-neutral" style="-fx-font-size: 24;" text="0" />
                    <Label styleClass="muted-text" text="Total Transactions" />
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="44" prefWidth="44" styleClass="stat-icon-success">
                    <Label style="-fx-font-size: 20;" text="📈" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="newRegistrationsLabel" styleClass="stat-number-neutral" style="-fx-font-size: 24;" text="0" />
                    <Label styleClass="muted-text" text="New Registrations" />
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="44" prefWidth="44" styleClass="stat-icon-warning">
                    <Label style="-fx-font-size: 20;" text="⚠️" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="reportsCountLabel" styleClass="stat-number-neutral" style="-fx-font-size: 24;" text="0" />
                    <Label styleClass="muted-text" text="Reports" />
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="44" prefWidth="44" styleClass="stat-icon-danger">
                    <Label style="-fx-font-size: 20;" text="🚨" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="fraudCasesLabel" styleClass="stat-number-neutral" style="-fx-font-size: 24;" text="0" />
                    <Label styleClass="muted-text" text="Suspected Fraud" />
                </VBox>
            </HBox>
        </VBox>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox prefWidth="500" styleClass="admin-card" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="Registration Statistics" />
            <BarChart fx:id="regChart" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                <xAxis><CategoryAxis label="Month" style="-fx-tick-label-fill: #555555;" /></xAxis>
                <yAxis><NumberAxis label="Users" style="-fx-tick-label-fill: #555555;" /></yAxis>
            </BarChart>
        </VBox>

        <VBox prefWidth="500" spacing="12" styleClass="admin-card" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="System Alerts" />

            <VBox fx:id="alertsContainer" spacing="8" VBox.vgrow="ALWAYS">
            </VBox>
        </VBox>
    </HBox>
</VBox>