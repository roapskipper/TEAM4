<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="1100" spacing="24" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.team4.controller.AdminDashboardController">

    <HBox spacing="16">
        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="44" prefWidth="44" styleClass="stat-icon-warning">
                    <Label style="-fx-font-size: 20;" text="⏳" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="pendingApprovalsLabel" styleClass="stat-number-neutral" style="-fx-font-size: 28;" text="8" />
                    <Label styleClass="muted-text" text="Pending Approvals" />
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="44" prefWidth="44" styleClass="stat-icon-danger">
                    <Label style="-fx-font-size: 20;" text="🚩" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="openReportsLabel" styleClass="stat-number-neutral" style="-fx-font-size: 28;" text="5" />
                    <Label styleClass="muted-text" text="Open Reports" />
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="44" prefWidth="44" styleClass="stat-icon-primary">
                    <Label style="-fx-font-size: 20;" text="👁" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="suspiciousAccountsLabel" styleClass="stat-number-neutral" style="-fx-font-size: 28;" text="3" />
                    <Label styleClass="muted-text" text="Suspicious Accounts" />
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="44" prefWidth="44" styleClass="stat-icon-success">
                    <Label style="-fx-font-size: 20;" text="⏱" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="endingSoonLabel" styleClass="stat-number-neutral" style="-fx-font-size: 28;" text="6" />
                    <Label styleClass="muted-text" text="Ending Soon (1h)" />
                </VBox>
            </HBox>
        </VBox>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox prefWidth="500" styleClass="admin-card" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="Reports Trend (Last 30 Days)" />
            <BarChart fx:id="regChart" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                <xAxis><CategoryAxis label="Day" style="-fx-tick-label-fill: #555555;" /></xAxis>
                <yAxis><NumberAxis label="Reports" style="-fx-tick-label-fill: #555555;" /></yAxis>
            </BarChart>
        </VBox>

        <VBox prefWidth="500" spacing="12" styleClass="admin-card" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="System Alerts" />

            <VBox fx:id="alertsContainer" spacing="8" VBox.vgrow="ALWAYS">
            </VBox>
        </VBox>
    </HBox>
</VBox>