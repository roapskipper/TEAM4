<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="1100" spacing="24" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.team4.controller.AdminDashboardController">

    <HBox spacing="16">
        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="44" prefWidth="44" styleClass="stat-icon-primary">
                    <Label style="-fx-font-size: 20;" text="0" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="totalUsersLabel" styleClass="stat-number-neutral" style="-fx-font-size: 28;" text="1,245" />
                    <Label styleClass="muted-text" text="Total Users" />
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="44" prefWidth="44" styleClass="stat-icon-danger">
                    <Label style="-fx-font-size: 20;" text="1" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="lockedUsersLabel" styleClass="stat-number-neutral" style="-fx-font-size: 28;" text="12" />
                    <Label styleClass="muted-text" text="Locked Accounts" />
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="44" prefWidth="44" styleClass="stat-icon-warning">
                    <Label style="-fx-font-size: 20;" text="2" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="pendingAuctionsLabel" styleClass="stat-number-neutral" style="-fx-font-size: 28;" text="8" />
                    <Label styleClass="muted-text" text="Pending Auctions" />
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane prefHeight="44" prefWidth="44" styleClass="stat-icon-success">
                    <Label style="-fx-font-size: 20;" text="3" />
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="liveAuctionsLabel" styleClass="stat-number-neutral" style="-fx-font-size: 28;" text="24" />
                    <Label styleClass="muted-text" text="Live Auctions" />
                </VBox>
            </HBox>
        </VBox>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox prefWidth="500" styleClass="admin-card" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="Registration Statistics" />
            <BarChart fx:id="regChart" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                <xAxis><CategoryAxis label="Month" style="-fx-tick-label-fill: #555555;" /></xAxis>
                <yAxis><NumberAxis label="Users" style="-fx-tick-label-fill: #555555;" /></yAxis>
            </BarChart>
        </VBox>

        <VBox prefWidth="500" spacing="12" styleClass="admin-card" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="System Alerts" />

            <VBox fx:id="alertsContainer" spacing="8" VBox.vgrow="ALWAYS">
            </VBox>
        </VBox>
    </HBox>
</VBox>