<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.team4.controller.AdminDashboardController"
      spacing="24"
      style="-fx-background-color: transparent;"
      prefWidth="1100">

    <HBox spacing="16">
        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane style="-fx-background-color: rgba(59,130,246,0.15); -fx-background-radius: 12;"
                           prefWidth="44" prefHeight="44">
                    <Label text="則" style="-fx-font-size: 20;"/>
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="totalUsersLabel" text="1,245" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Tong nguoi dung" style="-fx-font-size: 12; -fx-text-fill: #6b7280;"/>
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane style="-fx-background-color: rgba(239,68,68,0.15); -fx-background-radius: 12;" prefWidth="44" prefHeight="44">
                    <Label text="白" style="-fx-font-size: 20;"/>
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="lockedUsersLabel" text="12" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Tai khoan bi khoa" style="-fx-font-size: 12; -fx-text-fill: #6b7280;"/>
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane style="-fx-background-color: rgba(234,179,8,0.15); -fx-background-radius: 12;" prefWidth="44" prefHeight="44">
                    <Label text="竢ｳ" style="-fx-font-size: 20;"/>
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="pendingAuctionsLabel" text="8" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Phien cho duyet" style="-fx-font-size: 12; -fx-text-fill: #6b7280;"/>
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="admin-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane style="-fx-background-color: rgba(34,197,94,0.15); -fx-background-radius: 12;"
                           prefWidth="44" prefHeight="44">
                    <Label text="櫨" style="-fx-font-size: 20;"/>
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="liveAuctionsLabel" text="24" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Dang dien ra" style="-fx-font-size: 12; -fx-text-fill: #6b7280;"/>
                </VBox>
            </HBox>
        </VBox>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox styleClass="admin-card" HBox.hgrow="ALWAYS" prefWidth="500">
            <Label text="Thong ke dang ky" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 0 0 16 0;"/>
            <BarChart fx:id="regChart" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                <xAxis><CategoryAxis label="Thang" style="-fx-tick-label-fill: #6b7280;"/></xAxis>
                <yAxis><NumberAxis label="Nguoi dung" style="-fx-tick-label-fill: #6b7280;"/></yAxis>
            </BarChart>
        </VBox>

        <VBox styleClass="admin-card" HBox.hgrow="ALWAYS" prefWidth="500" spacing="12">
            <Label text="Canh bao he thong" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 0 0 4 0;"/>

            <VBox fx:id="alertsContainer" spacing="8" VBox.vgrow="ALWAYS">
            </VBox>
        </VBox>
    </HBox>
</VBox>